# Environment Variables for Nuclei Scanner
# Copy this to .env and fill in your values

# Home Assistant API Token
HOME_ASSISTANT_API_TOKEN=your_home_assistant_token_here

# ProjectDiscovery Cloud Platform API Key
PDCP_API_KEY=your_pdcp_api_key_here

# Ollama API endpoint (for future LLM integration)
OLLAMA_API=http://192.168.10.249:11434/v1